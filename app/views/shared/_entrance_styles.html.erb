<style nonce="<%= content_security_policy_nonce %>">
.is-style-loading body > :not(.preloader) { visibility: hidden; }
.preloader, .preloader * { box-sizing: border-box; }
.is-entrance-waiting .preloader-bar { animation: entrance-wait 900ms ease-in-out infinite alternate; }
@keyframes entrance-wait { to { opacity: 0.35; } }
/* First-visit preloader: only exists visually while the head script has set html.is-preloading.
   Sequence: labels rise in, then the sheet catches fire over the hero portrait and burns open while the digits
   roll and the words cycle; at 100 the rest burns away (see effects/paper_burn.js). */
.preloader {
  --canvas: #f5f0ea;
  --ink: #17110e;
  --muted: #6a5e56;
  --accent: #a94a2c;
  --night: #0e0a08;
  --glow: #e8683a;
  --serif: "Instrument Serif", Georgia, serif;
  --gutter: clamp(20px, 4vw, 64px);
  --ease-wipe: cubic-bezier(0.76, 0, 0.24, 1);
  font-family: "Inter Tight", system-ui, sans-serif;
  display: none;
}
.is-preloading body {
  overflow: hidden;
}
.is-preloading .preloader {
  position: fixed;
  inset: 0;
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: clamp(20px, 3vw, 40px) var(--gutter) clamp(28px, 4vw, 52px);
  background: var(--canvas);
  color: var(--ink);
  overflow: hidden;
  clip-path: inset(0 0 0 0);
  transition:
    clip-path 760ms var(--ease-wipe) 900ms,
    background-color 700ms ease 150ms;
}
.preloader-row {
  position: relative;
  z-index: 2;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-end;
  gap: 16px 32px;
}
.preloader-mask {
  display: block;
  overflow: hidden;
  padding-bottom: 0.08em;
}
.preloader-mask > * {
  display: block;
  transition: transform 560ms var(--ease-wipe);
}
.is-preloading .preloader-mask > * {
  animation: preloader-rise 900ms cubic-bezier(0.22, 1, 0.36, 1) backwards;
}
.preloader-row > :nth-child(2) > * { animation-delay: 80ms; }
.preloader-row > :nth-child(3) > * { animation-delay: 160ms; }
.preloader-row-bottom > :nth-child(1) > * { animation-delay: 220ms; }
.preloader-row-bottom > :nth-child(2) > * { animation-delay: 300ms; }
@keyframes preloader-rise {
  from { transform: translateY(110%); }
}
.preloader-mask-count {
  margin-left: auto;
}
.preloader-label {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted);
}
.preloader-line {
  font-size: clamp(24px, 2.8vw, 40px);
  font-weight: 300;
  line-height: 1.1;
  letter-spacing: -0.03em;
  white-space: nowrap;
}
.preloader-words {
  display: inline-block;
  height: 1.1em;
  overflow: hidden;
  vertical-align: bottom;
  padding-right: 0.15em;
}
.preloader-words-track {
  display: block;
  transform: translateY(calc(var(--word, 0) * -1.1em));
  transition: transform 520ms var(--ease-wipe);
}
.preloader-words em {
  display: block;
  height: 1.1em;
  font-family: var(--serif);
  font-weight: 400;
  letter-spacing: -0.01em;
  color: var(--accent);
}
.preloader-count {
  display: flex;
  align-items: flex-start;
  font-size: clamp(112px, 24vw, 360px);
  font-weight: 200;
  line-height: 1;
  letter-spacing: -0.06em;
  font-variant-numeric: tabular-nums;
}
/* Cells are cropped to the figure height (Inter Tight digits are ~0.73em) so the roll reads cleanly. */
.preloader-digit {
  display: block;
  height: 0.78em;
  max-width: 1em;
  overflow: hidden;
  transition: max-width 500ms var(--ease-wipe);
}
.preloader-digit.is-blank {
  max-width: 0;
}
.preloader-digit-strip {
  display: block;
  transform: translateY(calc(var(--digit, 0) * -0.78em));
  transition: transform 380ms cubic-bezier(0.65, 0, 0.35, 1);
}
.preloader-digit-strip > span {
  display: block;
  height: 0.78em;
  line-height: 0.78em;
}
.preloader-count sup {
  margin: 0 0 0 0.08em;
  font-family: var(--serif);
  font-style: italic;
  font-weight: 400;
  font-size: 0.24em;
  letter-spacing: 0;
  line-height: 1;
}
.preloader-bar {
  position: absolute;
  inset: auto 0 0;
  height: 2px;
  background: var(--glow);
  z-index: 2;
  transform: scaleX(var(--progress, 0));
  transform-origin: left;
  transition: opacity 400ms ease;
}
/* Burn exit: once the WebGL sheet has drawn its first frame it stands in for the DOM paper. */
.paper-burn {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
.paper-burn-sparks {
  z-index: 3;
}
.preloader.is-burning {
  background-color: transparent;
  pointer-events: none;
  transition: none;
}
/* A label the fire reaches browns, blurs and crumbles away. */
.preloader-mask.is-burnt > * {
  color: #3b1e0d;
  opacity: 0;
  filter: blur(4px);
  transition:
    color 200ms ease,
    opacity 500ms ease 150ms,
    filter 500ms ease 150ms,
    transform 560ms var(--ease-wipe);
}
.preloader.is-leaving .preloader-bar {
  opacity: 0;
}
/* Wipe exit (no WebGL): the sheet dims to the hero's night tone as it lifts away. */
.preloader.is-wiping {
  clip-path: inset(0 0 100% 0);
  background-color: var(--night);
}
.preloader.is-leaving .preloader-mask > * {
  transform: translateY(-110%);
}
@media (max-width: 560px) {
  .preloader-mask-title {
    display: none;
  }
}

</style>
