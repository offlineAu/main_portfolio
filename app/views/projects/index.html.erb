<% content_for :title, 'Projects' %>
<div class="page-heading">
  <div>
    <p class="eyebrow">PORTFOLIO</p>
    <h1>Projects</h1>
    <p class="page-subtitle">A collection of web apps, mobile experiences, and practical automation.</p>
  </div>
  <span class="count-label"><%= Project.published.count %> selected projects</span></div>
<%= form_with url: projects_path, method: :get, class: 'filter-bar' do |form| %><%= form.label :technology, 'Explore the stack' %><%= form.select :technology, options_for_select([['All technologies', '']] + @technologies.map { |name| [name, name] }, @technology) %><%= form.submit 'Filter projects', class: 'button button-small button-dark' %><%= link_to 'Reset', projects_path, class: 'text-link' if @technology.present? %><% end %>
<% if @projects.any? %>
  <div class="projects-grid"><% @projects.each do |project| %><%= render 'shared/project_card', project: project, featured: false %><% end %></div>
<% else %>
  <div class="empty-state">
    <h2>No projects with that technology yet.</h2>
    <%= link_to 'Explore all projects', projects_path, class: 'text-link' %></div>
<% end %>
