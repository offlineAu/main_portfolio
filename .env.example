# Rails uses real environment variables; load these with your shell or hosting provider.
DATABASE_URL=postgresql://localhost/airl_portfolio_development
APP_URL=http://localhost:3000

# Production only: set RAILS_ENV=production and SECRET_KEY_BASE (bin/rails secret).
# Optional: fixed keys for the encrypted two-factor secret (bin/rails db:encryption:init).
# Without them the keys derive from SECRET_KEY_BASE.
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
# Never commit live credentials. PostgreSQL URL comes from Railway.
# Set ACTIVE_STORAGE_SERVICE=amazon and the Railway bucket's S3-compatible values:
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
